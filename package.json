{
    "name": "libbase64",
    "version": "1.4.1",
    "description": "Encode and decode base64 encoded strings",
    "type": "module",
    "main": "./dist/cjs/libbase64.js",
    "types": "./dist/cjs/libbase64.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/libbase64.js",
            "require": "./dist/cjs/libbase64.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-concurrency=1 $(find test -name \"*-test.ts\")",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test --test-concurrency=1 $(find test -name \"*-test.ts\")",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install",
        "test:fuzz": "FC_NUM_RUNS=20000 node --import tsx --test test/libbase64-property-test.ts",
        "pretest:bun": "npm run build",
        "test:bun": "bun test --timeout 60000 $(find ./test -name \"*-test.ts\")"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nodemailer/libbase64.git"
    },
    "keywords": [
        "base64",
        "mime"
    ],
    "author": "Andris Reinman",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/nodemailer/libbase64/issues"
    },
    "homepage": "https://github.com/nodemailer/libbase64",
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "fast-check": "4.10.2",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
